# ====================================================================
# AgriSupply Chain & Smart Cold-Chain Logistics Platform Environment Configuration
# ====================================================================

# Database
DATABASE_URL=./backend/data/agrisupply.db
PORT=5000
NODE_ENV=production

# JWT Authentication Secrets
JWT_SECRET=super_secret_jwt_key_enterprise_agrisupply_2026_min_32_chars
JWT_REFRESH_SECRET=super_secret_refresh_key_enterprise_agrisupply_2026_min_32_chars

# External APIs
MAP_API_KEY=your_mapbox_or_google_maps_api_key
WEATHER_API_KEY=your_open_weather_or_meteo_key

# Email / SMTP
SMTP_HOST=smtp.mailtrap.io
SMTP_USER=smtp_username
SMTP_PASSWORD=smtp_password

# IoT / MQTT Broker
MQTT_URL=mqtt://broker.hivemq.com:1883
MQTT_USERNAME=agri_iot_user
MQTT_PASSWORD=agri_iot_password

# Object Storage (S3 / MinIO)
STORAGE_URL=https://storage.agrisupply.io
STORAGE_KEY=storage_access_key_secret

# Push Notifications (Firebase / Apple APNs)
PUSH_NOTIFICATION_KEY=fcm_server_key_here

# Telemetry Simulator
ENABLE_IOT_SIMULATOR=true
