DATABASE_URL=./data/agrisupply.db
PORT=5000
NODE_ENV=production
JWT_SECRET=your_jwt_secret_min_32_characters
JWT_REFRESH_SECRET=your_refresh_secret_min_32_characters
MAP_API_KEY=your_maps_api_key
WEATHER_API_KEY=your_weather_api_key
SMTP_HOST=smtp.mailtrap.io
SMTP_USER=user
SMTP_PASSWORD=password
MQTT_URL=mqtt://broker.hivemq.com:1883
MQTT_USERNAME=agri_user
MQTT_PASSWORD=agri_pass
STORAGE_URL=https://storage.agrisupply.com
STORAGE_KEY=storage_secret_key
PUSH_NOTIFICATION_KEY=fcm_server_key
ENABLE_IOT_SIMULATOR=true
